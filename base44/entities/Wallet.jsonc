{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "coin": {
      "type": "string",
      "enum": [
        "BTC",
        "ETH",
        "USDT",
        "USDC"
      ]
    },
    "available": {
      "type": "number",
      "default": 0
    },
    "locked": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "coin"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}