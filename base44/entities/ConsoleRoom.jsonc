{
  "name": "ConsoleRoom",
  "type": "object",
  "properties": {
    "room_code": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "wii",
        "switch",
        "ps5",
        "xbox",
        "pc",
        "mobile"
      ]
    },
    "game_slug": {
      "type": "string"
    },
    "game_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "lobby_code": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "host_handle": {
      "type": "string"
    },
    "guest_id": {
      "type": "string"
    },
    "guest_handle": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "matched",
        "closed"
      ],
      "default": "open"
    },
    "starts_at": {
      "type": "string"
    }
  },
  "required": [
    "room_code",
    "platform",
    "game_slug",
    "game_name",
    "host_id",
    "host_handle",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.host_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}