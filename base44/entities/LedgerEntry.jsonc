{
  "name": "LedgerEntry",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "coin": {
      "type": "string",
      "enum": [
        "BTC",
        "ETH",
        "USDT",
        "USDC"
      ]
    },
    "amount": {
      "type": "number"
    },
    "kind": {
      "type": "string",
      "enum": [
        "deposit",
        "withdrawal",
        "withdrawal_hold",
        "stake",
        "payout",
        "refund",
        "fee"
      ]
    },
    "description": {
      "type": "string"
    },
    "balance_after": {
      "type": "number"
    },
    "ref_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "coin",
    "amount",
    "kind"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}