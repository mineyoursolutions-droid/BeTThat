{
  "name": "MatchMessage",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sender_id": {
      "type": "string"
    },
    "sender_handle": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "creator",
        "challenger"
      ]
    },
    "body": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "file_kind": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ]
    }
  },
  "required": [
    "match_id",
    "sender_id",
    "members"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}